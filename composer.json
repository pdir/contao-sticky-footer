{
    "name": "pdir/contao-sticky-footer",
    "description": "Sticky footer for the backend with pure css and no javascript. Adds a class \"debug\" to the body if debug mode is active.",
    "keywords": [
        "sticky",
        "footer",
        "backend"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Webdesign für Dresden",
            "homepage": "https://pdir.de",
            "email": "develop@pdir.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/pdir/contao-sticky-footer/issues",
        "source": "https://github.com/pdir/contao-sticky-footer"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0"
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.0 || ^7.0",
        "contao/manager-plugin": "^2.3",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "Pdir\\ContaoStickyFooterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pdir\\ContaoStickyFooterBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Pdir\\ContaoStickyFooterBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        }
    }
}
